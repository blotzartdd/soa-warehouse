{
  "title": "Warehouse Consumer",
  "uid": "warehouse-consumer",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Consumer Lag by Partition",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "consumer_lag",
          "legendFormat": "partition={{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Events Processed per Second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(events_processed_total[1m])",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cassandra Write Errors (total)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "cassandra_write_errors_total",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Event Processing Duration (p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(event_processing_duration_seconds_bucket[1m]))",
          "legendFormat": "p99 {{event_type}}",
          "refId": "A"
        }
      ]
    }
  ]
}
